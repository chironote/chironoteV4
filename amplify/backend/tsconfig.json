{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es2022", "esnext.disposable", "dom"],
    "module": "commonjs",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "build",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": ["api/*/override.ts"]
}
